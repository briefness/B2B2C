<?xml version="1.0" encoding="utf-8"?>
<!-- Android 网络安全配置
     禁止所有明文 HTTP 通信，仅允许 HTTPS -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- TODO: 添加 SSL Pinning 配置（当占位符替换为真实证书后）
